# Copy to .env and fill in. .env is gitignored.
YOUTUBE_API_KEY=        # Google Cloud console, YouTube Data API v3. Without it the prototype falls back to yt-dlp.
GEMINI_API_KEY=         # aistudio.google.com. Needed only for the watch tier.
GEMINI_MODEL=gemini-3-flash-preview
ANTHROPIC_API_KEY=      # or any credential the Anthropic SDK already resolves
CLAUDE_MODEL=claude-opus-5-5
